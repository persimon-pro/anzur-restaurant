{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/review", "destination": "/review.html" },
    { "source": "/otzyv", "destination": "/review.html" }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/menu", "destination": "/menu_ru", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg|pdf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(backups/.*|index.backup-v1|variant.*|test-hero.*)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
